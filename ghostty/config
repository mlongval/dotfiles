# Ghostty configuration
# Docs: https://ghostty.org/docs/config

# Fullscreen. Ghostty 1.3.x already defaults to ctrl+enter;
# F11 is bound as well to match the usual terminal convention.
keybind = f11=toggle_fullscreen

# Ne pas afficher le toast « Copied to clipboard » : nvim/tmux/Claude Code
# écrivent le presse-papier via OSC 52 et Ghostty le notifiait à chaque fois.
app-notifications = no-clipboard-copy
