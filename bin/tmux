#!/usr/bin/env bash
# Wrapper around /usr/bin/tmux:
#   no args -> pick/create a session interactively
#   any args -> pass straight through to real tmux
set -euo pipefail

REAL_TMUX=/usr/bin/tmux

if [ $# -gt 0 ]; then
    exec "$REAL_TMUX" "$@"
fi

# Already inside tmux? just run it (will error appropriately)
if [ -n "${TMUX:-}" ]; then
    exec "$REAL_TMUX"
fi

attach_or_link() {
    local s="$1"
    if [ "$("$REAL_TMUX" list-clients -t "$s" 2>/dev/null | wc -l)" -gt 0 ]; then
        # Session already has a client — create a linked session so this
        # terminal navigates windows independently. destroy-unattached
        # cleans the linked session up when this terminal detaches.
        exec "$REAL_TMUX" new-session -t "$s" \; set-option destroy-unattached on
    else
        exec "$REAL_TMUX" attach-session -t "$s"
    fi
}

new_named_session() {
    printf 'Name for new session (ENTER for default): '
    read -r name </dev/tty
    if [ -z "$name" ]; then
        exec "$REAL_TMUX" new-session
    else
        exec "$REAL_TMUX" new-session -s "$name"
    fi
}

mapfile -t sessions < <("$REAL_TMUX" list-sessions -F '#{session_name}' 2>/dev/null || true)
n=${#sessions[@]}

# "name<TAB>annotation" — sessions in a group of size>1 are flagged so the
# picker shows which siblings share windows. cut -f1 strips the annotation.
build_display() {
    "$REAL_TMUX" list-sessions \
        -F '#{session_name}	#{session_group}	#{session_group_size}' 2>/dev/null \
    | awk -F'\t' '{
        name=$1; group=$2; size=$3
        if (size+0 > 1) {
            if (name == group) printf "%s\t[group %s: root]\n", name, group
            else                printf "%s\t[group %s: linked]\n", name, group
        } else {
            printf "%s\t\n", name
        }
    }'
}

case $n in
    0)
        new_named_session
        ;;
    1)
        s="${sessions[0]}"
        printf 'Attach to existing session "%s"? [Y/n] ' "$s"
        read -r ans </dev/tty
        case "${ans,,}" in
            n|no) new_named_session ;;
            *)    attach_or_link "$s" ;;
        esac
        ;;
    *)
        choice=$({ printf 'new\t\n'; build_display; } | \
            fzf --height=40% --reverse --prompt='tmux> ' \
                --header='enter=select  esc=cancel  j/k or arrows to move' \
                --no-multi --delimiter=$'\t' --with-nth=1,2 --tabstop=20 \
            | cut -f1)
        [ -z "${choice:-}" ] && exit 0
        if [ "$choice" = "new" ]; then
            new_named_session
        else
            attach_or_link "$choice"
        fi
        ;;
esac
