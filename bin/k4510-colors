#!/usr/bin/env bash
# k4510-colors -- one line in each colour a Linux program can show on the
# K4510, named as the K4510 shows it.  A program asks for an ANSI colour
# (30-37, 90-97); JIM turns it into one of the machine's sixteen
# (core/term.c: apal, apalb), from whatever palette is loaded (CLEAR, C64...).
# The swatch is the exact colour, as a background; the text is what JIM
# draws, which lifts a colour too dim to read on the background.
#
# Orange (8), brown (9), grey (C) and light grey (F) have no ANSI code, so
# no Linux program reaches them.  (ESC [ ? 4510 h would, but tmux drops it.)
rows=(
    "30 0 black"      "37 1 white"       "31 2 red"         "36 3 cyan"
    "35 4 purple"     "32 5 green"       "34 6 blue"        "33 7 yellow"
    "91 A light red"  "90 B dark grey"   "92 D light green" "94 E light blue"
)
for r in "${rows[@]}"; do
    read -r code idx name <<<"$r"
    printf '\e[%dm    \e[0m %s \e[%dm%-11s The quick brown fox jumps over the lazy dog\e[0m\n' \
        $((code + 10)) "$idx" "$code" "$name"
done
echo "not reachable from Linux: 8 orange, 9 brown, C grey, F light grey"
