# Status theme — see ~/dotfiles/themes/README.md (switch with `statustheme`).
# Picks this shell's theme ($_st_dir); a K4510 terminal always gets VT220.
source ~/dotfiles/zsh/statustheme.zsh
# Some themes need a hook this early (e.g. p10k instant prompt).
[[ -r $_st_dir/zsh-early.zsh ]] && source $_st_dir/zsh-early.zsh

source $HOME/.profile
source $HOME/.functions
source $HOME/.bash_aliases

# Disable passwordless sudo if it was left enabled
if [ -f /etc/sudoers.d/doc-nopasswd ]; then
    sudo "$HOME/bin/toggle-sudo" disable 2>/dev/null || true   # by path: not on sudo's secure_path
fi

command -v fastfetch >/dev/null 2>&1 && fastfetch -l none
[ -x ~/bin/clinic_days.py ] && python3 ~/bin/clinic_days.py

# History
HISTFILE=~/.histfile
HISTSIZE=1000
SAVEHIST=1000

# Vi mode
bindkey -v
bindkey -M viins 'jk' vi-cmd-mode

# Options
setopt AUTO_CD

# Completion
zstyle :compinstall filename '$HOME/.zshrc'
autoload -Uz compinit
compinit
zstyle ':completion:*' menu select
fpath+=~/.zfunc

# Prompt — comes from the status theme; open shells follow `statustheme use`.
_st_load $_st_dir
precmd_functions=(_st_follow $precmd_functions)

# Bun
[ -s "$HOME/.bun/_bun" ] && source "$HOME/.bun/_bun"
export BUN_INSTALL="$HOME/.bun"
export PATH="$BUN_INSTALL/bin:$PATH"


export PATH="$HOME/.npm-global/bin:$PATH"

# OpenClaw Completion
[ -f "$HOME/.openclaw/completions/openclaw.zsh" ] && source "$HOME/.openclaw/completions/openclaw.zsh"

[ -f "$HOME/.local/bin/env" ] && . "$HOME/.local/bin/env"

# Added by claude-code-plus for shell alias
claude+() {
  env -u TMUX SHELL="/bin/bash" CLAUDE_CODE_PLUS=1 "$(command -v claude)" "$@"
}