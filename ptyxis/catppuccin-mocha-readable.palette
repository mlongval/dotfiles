# Catppuccin Mocha, with the two dark "grey" ANSI colors lifted for readability.
#
# Stock Mocha sets Color0=#45475a (Surface1) and Color8=#585b70 (Surface2),
# both of which sit too close to the #1e1e2e background -> dim text reads as
# "black on dark grey" in htop, ranger, etc. They are lifted to the Overlay
# tones so they clear WCAG >=3:1 against the background in BOTH normal and
# alt-i (true RGB negation) inverted modes:
#
#   Color0  #45475a -> #7f849c (Overlay1)   normal 4.44:1 / inverted 3.22:1
#   Color8  #585b70 -> #9399b2 (Overlay2)   normal 5.81:1 / inverted 4.36:1
#
# [Light] and [Dark] are identical on purpose: appearance is driven by alt-i
# (invert-colors-win), not by system day/night switching.

[Palette]
Name=Catppuccin Mocha (readable)

[Dark]
Background=#1e1e2e
Foreground=#cdd6f4
Cursor=#f5e0dc
CursorForeground=#1e1e2e
Color0=#7f849c
Color1=#f38ba8
Color2=#a6e3a1
Color3=#f9e2af
Color4=#89b4fa
Color5=#f5c2e7
Color6=#94e2d5
Color7=#bac2de
Color8=#9399b2
Color9=#f38ba8
Color10=#a6e3a1
Color11=#f9e2af
Color12=#89b4fa
Color13=#f5c2e7
Color14=#94e2d5
Color15=#a6adc8

[Light]
Background=#1e1e2e
Foreground=#cdd6f4
Cursor=#f5e0dc
CursorForeground=#1e1e2e
Color0=#7f849c
Color1=#f38ba8
Color2=#a6e3a1
Color3=#f9e2af
Color4=#89b4fa
Color5=#f5c2e7
Color6=#94e2d5
Color7=#bac2de
Color8=#9399b2
Color9=#f38ba8
Color10=#a6e3a1
Color11=#f9e2af
Color12=#89b4fa
Color13=#f5c2e7
Color14=#94e2d5
